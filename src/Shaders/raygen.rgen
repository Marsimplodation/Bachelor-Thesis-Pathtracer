#version 460
#extension GL_EXT_ray_tracing : require
#include "include/types.h"

layout(binding = 3, rgba8) uniform image2D storageImage;
layout(set = 0, binding = 4) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 5) uniform CameraBlock {
    vec4 position;  // Camera position
    vec4 forward; // Camera direction (where it's looking)
    vec4 right; // Camera direction (where it's looking)
    vec4 up;        // Up vector
    float fov;          // Field of view
    float yaw;
    float pitch;
    float roll;
} camera;
layout(location = 0) rayPayloadEXT RayPayload rayPayload;


void main() {
    ivec2 pixelCoords = ivec2(gl_LaunchIDEXT.xy);
    ivec2 imageSize = imageSize(storageImage);
    vec2 coords = vec2(pixelCoords) / vec2(imageSize);
    vec2 ndc = 2*coords - vec2(1.0);
    ndc.y = -ndc.y;
   
    vec3 cameraForward = {0,0,-1};
    vec3 cameraRight = {1,0,0};
    vec3 cameraUp = {0,1,0};

    vec3 origin = camera.position.xyz; 
    vec3 direction = ndc.x*camera.right.xyz + ndc.y*camera.up.xyz + camera.fov*camera.forward.xyz; // Ray direction pointing forward
    direction = normalize(direction); 
    rayPayload.hitColor = vec3(0.0); // Default color in case the ray misses
    


    traceRayEXT(
        topLevelAS, 
        gl_RayFlagsOpaqueEXT, 
        0xFF, 
        0,    // SBT record offset
        1,    // SBT record stride
        0,    // Miss shader index
        origin, 
        0.0, 
        direction, 
        100.0, 
        0 // location of the payload
    );

    vec4 outputColor = vec4(rayPayload.hitColor, 1.0);

    // Write the color to the storage image
    imageStore(storageImage, pixelCoords, outputColor);
}

