#version 460
#extension GL_EXT_ray_tracing : require

layout(binding = 3, rgba8) uniform image2D storageImage;
layout(set = 0, binding = 4) uniform accelerationStructureEXT topLevelAS;
layout(location = 0) rayPayloadEXT vec3 hitColor;

void main() {
    vec3 origin = vec3(0.0, 0.0, -5.0);
    vec3 direction = normalize(vec3(gl_LaunchIDEXT.xy - vec2(0.5), 1.0));
    // Get the ray launch ID
    ivec2 pixelCoords = ivec2(gl_LaunchIDEXT.xy);
    ivec2 imageSize = imageSize(storageImage);

    // Normalize pixel coordinates to [0.0, 1.0]
    vec2 normalizedCoords = vec2(pixelCoords) / vec2(imageSize);

    // Create a gradient color based on normalized coordinates
    vec4 color = vec4(normalizedCoords.x, normalizedCoords.y, 1.0 - normalizedCoords.x, 1.0); // RGBA

    // Write the gradient color to the storage image
    imageStore(storageImage, pixelCoords, color);
    return;

    traceRayEXT(
        topLevelAS, 
        gl_RayFlagsOpaqueEXT, 
        0xFF, 
        0,    // SBT record offset
        1,    // SBT record stride
        0,    // Miss shader index
        origin, 
        0.0, 
        direction, 
        100.0, 
        0
    );
}

