#version 460
#extension GL_EXT_ray_tracing : require


layout(location = 0) rayPayloadEXT vec3 hitColor; // The color to output

void main() {
    // Simple color based on the ray's launch ID (pixel coordinates)
    vec3 color = vec3(gl_LaunchIDEXT.x / 1024.0, gl_LaunchIDEXT.y / 768.0, 1.0); // Example gradient color
    
    // Assign the color to the ray payload (this will be the output color)
    hitColor = color;
    return;
}


